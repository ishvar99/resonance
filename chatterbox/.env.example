# Chatterbox inference service configuration.
# Copy to .env and fill in. Never commit the real file.

# Required. Must match CHATTERBOX_API_KEY in the Next.js app.
# Generate with: openssl rand -hex 32
CHATTERBOX_API_KEY=

# turbo (default) | nano | standard
CHATTERBOX_MODEL=turbo

# cuda | mps | cpu. Auto-detected when unset.
CHATTERBOX_DEVICE=

# Concurrent generations per GPU. Raise only with headroom to spare.
CHATTERBOX_MAX_CONCURRENCY=1

# Must match MAX_GENERATION_CHARACTERS in the Next.js app.
CHATTERBOX_MAX_CHARACTERS=5000

# Cache Hugging Face weights on a mounted volume.
HF_HOME=/models

# Only needed for gated Hugging Face repositories.
HF_TOKEN=

# Optional fallback: lets the service resolve `voice_key` from the bucket
# directly. Leave unset when the app sends signed `voice_url`s (the default).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

LOG_LEVEL=INFO
# Set to 1 to expose /docs. Leave off in production.
ENABLE_DOCS=
