# Resonance environment configuration.
#
# Copy to `.env` and fill in. Never commit `.env`.
# Validated by `src/lib/environment.ts` (T3 Env + Zod) — the app refuses to boot
# with an invalid configuration.
#
# In development, storage / speech / billing fall back to clearly-marked local
# adapters when their credentials are absent. In production those fallbacks are
# disabled and a missing credential is a boot failure.

# ---------------------------------------------------------------------------
# Database (required) — PostgreSQL
# ---------------------------------------------------------------------------
# Local:  docker run -d --name resonance-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
# Hosted: `npx create-db` for a free Prisma Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resonance?schema=public"

# ---------------------------------------------------------------------------
# Clerk (required) — authentication and organizations
# ---------------------------------------------------------------------------
# https://dashboard.clerk.com → API keys.
# Organizations MUST be enabled: Configure → Organizations → Enable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# Chatterbox (optional in development, required in production)
# ---------------------------------------------------------------------------
# The self-hosted GPU service in ./chatterbox. Without these, generations return
# clearly-labelled development preview audio instead of speech.
# CHATTERBOX_API_KEY must match the value set on the inference service.
CHATTERBOX_API_URL=""
CHATTERBOX_API_KEY=""
CHATTERBOX_TIMEOUT_MS="180000"

# ---------------------------------------------------------------------------
# Object storage (optional in development, required in production)
# ---------------------------------------------------------------------------
# Cloudflare R2 by default; any S3-compatible service works.
# R2:    https://dash.cloudflare.com → R2 → Manage API tokens
# MinIO: set R2_ENDPOINT=http://localhost:9000 and R2_REGION=us-east-1
# AWS:   set R2_ENDPOINT=https://s3.<region>.amazonaws.com and R2_REGION=<region>
#
# Without these, audio is written to LOCAL_STORAGE_DIR on disk.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="resonance"
R2_REGION="auto"
# Overrides the endpoint derived from R2_ACCOUNT_ID.
R2_ENDPOINT=""
# Only set if the bucket is genuinely public. Audio is served through
# /api/audio by default, which authorises every request.
R2_PUBLIC_URL=""
LOCAL_STORAGE_DIR=".resonance/storage"

# ---------------------------------------------------------------------------
# Polar (optional in development, required in production) — usage billing
# ---------------------------------------------------------------------------
# https://polar.sh → Settings → Developers → New token.
# POLAR_PRODUCT_ID is the product customers are sent to on upgrade.
# Without these, free-tier limits are still enforced locally but no payment can
# be taken.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="sandbox"
POLAR_PRODUCT_ID=""

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
# DSN enables error reporting; the auth token additionally uploads source maps.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL, used to build checkout return URLs. Must be the public
# origin in production.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Resonance"
